---
import { Font, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { Resource, ResourceTypes } from '@4bitlabs/sci0';
import { Sci0Renderer } from '@components/react/sci0-renderer';

import Page from '@layouts/page.astro';

export async function getStaticPaths() {
  const sci0Pics = await getCollection('sci0pics');
  const sci0Data = Object.fromEntries(
    (
      await getCollection(
        'sci0data',
        (it) => Resource.getType(it.data.id) === ResourceTypes.PIC_TYPE,
      )
    ).map((it) => [it.id, it]),
  );
  return sci0Pics.flatMap((it) => {
    const data = sci0Data[it.data.source.id];
    if (!data) return [];
    const picNum = Resource.getNumber(data.data.id);
    return {
      params: {
        game: it.data.game.id,
        pic: picNum.toString(10),
      },
      props: { id: it.id },
    };
  });
}

const { id } = Astro.props;

const picEntry = await getEntry('sci0pics', id);
if (!picEntry) return new Response(null, { status: 404 });

const gameEntry = await getEntry(picEntry.data.game);
if (!gameEntry) return new Response(null, { status: 404 });

const dataEntry = await getEntry(picEntry.data.source);
if (!dataEntry) return new Response(null, { status: 404 });

const { thumbnailAlt, description, game } = picEntry.data;
const gameName = gameEntry.data.name + (gameEntry.data.demo ? ' Demo' : '');
const compression = dataEntry.data.compression;
const data = dataEntry.data.content;
const pic = Resource.getNumber(dataEntry.data.id);

const thumbnail = await getImage({
  src: `/sci0/${game.id}/pic/${pic}.thumbnail.png`,
  width: 380,
  height: 380,
  format: 'png',
});

const altText =
  thumbnailAlt ??
  `Rendering of ${gameName} asset pic.${pic.toString(10).padStart(3, '0')}`;

const pageImage = {
  src: new URL(thumbnail.src, Astro.url),
  alt: altText,
};

const flavorText = description || thumbnailAlt;
---

<Page
  title={`SCI Explorer: ${gameName} - pic.${pic.toString(10).padStart(3, '0')}`}
  image={pageImage}
>
  <Fragment slot="head">
    <Font cssVariable="--font-sci-000" preload />
  </Fragment>
  <h1><a href={`/sci0/${game.id}`}>{gameName}</a></h1>
  <h2><pre>PIC.{pic.toString(10).padStart(3, '0')}</pre></h2>
  {flavorText && <p>&ldquo;{flavorText}&rdquo;</p>}
  <Sci0Renderer
    client:only="react"
    engine={gameEntry.data.engine}
    data={data}
    compression={compression}
    initialAspectRatio={gameEntry.data.aspectRatio}
    label={altText}
    initialMixer={picEntry.data.dither}
  />
</Page>

<style>
  h2 {
    margin-block-start: 0.5rlh;
    user-select: none;
    margin-block-end: 0.125rlh;
  }

  h2 pre {
    font: normal calc(16px * 3) var(--font-sci-000);
    color: black;
    letter-spacing: normal;
  }
</style>
