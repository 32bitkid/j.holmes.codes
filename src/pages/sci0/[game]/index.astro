---
import { Font, getImage, Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { Resource } from '@4bitlabs/sci0';
import Page from '@layouts/page.astro';

export async function getStaticPaths() {
  const sci0Games = await getCollection('sci0games');
  return sci0Games.map((it) => {
    return {
      params: { game: it.id },
      props: { id: it.id },
    };
  });
}

const { id } = Astro.props;
const entry = await getEntry('sci0games', id);
if (!entry) return new Response(null, { status: 404 });

const name = entry.data.name + (entry.data.demo ? ' Demo' : '');
const pics = await getCollection('sci0pics', ({ data }) => data.game.id === id);
const sourceIds = pics.flatMap((pic) => pic.data.source.id);
const dataMap = Object.fromEntries(
  (await getCollection('sci0data', (it) => sourceIds.includes(it.id))).map(
    (it) => [it.id, it],
  ),
);

const thumbnail = await getImage({
  src: entry.data.cover,
  width: 380,
  height: 380,
  format: 'png',
});
---

<Page
  title={`SCI0 Explorer: ${name}`}
  image={{ src: new URL(thumbnail.src, Astro.url), alt: `${name}` }}
>
  <Fragment slot="head">
    <Font cssVariable="--font-sci-999" preload />
  </Fragment>
  <h1>{name}</h1>
  <ul>
    {
      pics.length ? (
        pics.map((pic) => {
          const resId  = dataMap[pic.data.source.id]?.data.id;
          const num = Resource.getNumber(resId);
          return (
              <li>
                <a href={`/sci0/${id}/pic/${num}`}>
                  <Image
                      class:list={[`ar_${entry.data.aspectRatio}`]}
                      src={`/sci0/${id}/pic/${num}.thumbnail.png`}
                      alt={pic.data.thumbnailAlt}
                      width="320"
                      height="190"
                  />
                  <pre class="picId">PIC.{num.toString(10).padStart(3, '0')}</pre>
                </a>
              </li>
          );
        })
      ) : (
        <em>Coming soon…</em>
      )
    }
  </ul>
</Page>

<style>
  ul {
    display: grid;
    gap: 1rlh 1ch;
    grid-template-columns: repeat(auto-fit, minmax(27ch, 1fr));
  }

  ul a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25ch;
  }

  ul img {
    box-sizing: border-box;
    width: 100%;
    height: fit-content;
    border-radius: 1ch;

    &.ar_1\:1 {
      aspect-ratio: 32 / 19;
    }

    &.ar_1\:1\.2 {
      aspect-ratio: 80 / 57;
    }
  }

  .picId {
    font: normal 24px var(--font-sci-999);
    color: black;
    font-variant-numeric: proportional-nums;
    align-self: end;
    margin-inline-end: 0.5ch;
  }


</style>
