---
import { Font, getImage, Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Page from '@layouts/page.astro';

export async function getStaticPaths() {
  const sci0Games = await getCollection('sci0games');
  return sci0Games.map((it) => {
    return {
      params: { game: it.id },
      props: { id: it.id },
    };
  });
}

const { id } = Astro.props;
const entry = await getEntry('sci0games', id);
if (!entry) return new Response(null, { status: 404 });
const { data: titleData } = entry;
const name = titleData.name + (titleData.demo ? ' Demo' : '');
const pics = await getCollection('sci0pics', ({ data }) => data.game.id === id);

const thumbnail = await getImage({
  src: titleData.cover,
  width: 380,
  height: 380,
  format: 'png',
});
---

<Page
  title={`SCI0 Explorer: ${name}`}
  image={{ src: new URL(thumbnail.src, Astro.url), alt: `${name}` }}
>
  <Fragment slot="head">
    <Font cssVariable="--font-sci-999" preload />
  </Fragment>
  <h1>{name}</h1>
  <ul>
    {
      pics.length ? (
        pics.map((pic) => (
          <li>
            <a href={`/sci0/${id}/pic/${pic.data.pic}`}>
              <Image
                src={pic.data.thumbnail}
                alt={pic.data.thumbnailAlt}
                width="320"
              />
              <pre class="picId">PIC.{pic.data.pic.toString(10).padStart(3, '0')}</pre>
            </a>
          </li>
        ))
      ) : (
        <em>Coming soon…</em>
      )
    }
  </ul>
</Page>

<style>
  ul {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rlh 1ch;
  }

  ul a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1ch;
  }

  ul img {
    box-sizing: border-box;
    width: 100%;
    height: fit-content;
    border-radius: 1ch;
    box-shadow: 0 0.5ch 1ch rgba(0, 0, 0, 0.2);
  }

  .picId {
    font: normal 24px var(--font-sci-999);
    color: black;
    font-variant-numeric: proportional-nums;
  }
</style>
