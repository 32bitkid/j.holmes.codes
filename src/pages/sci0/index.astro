---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Page from '../../layouts/page.astro';

const list = (await getCollection('sci0games')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<Page title="SCI Explorer">
  <h1>SCI Explorer</h1>

  <ul>
    {
      list.map(({ id, data: it }) => (
        <li>
          <a href={`/sci0/${id}`}>
            <Picture class="cover" src={it.cover} alt="Cover Art" width="256"/>
            {it.name}{it.demo ? " Demo" : ""}
          </a>
        </li>
      ))
    }
  </ul>
</Page>

<style>
  h1 {
    margin-bottom: 1rlh;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20ch, 1fr));
    gap: 1rlh 1ch;
    align-items: baseline;
  }

  ul a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1ch;
  }

  ul li {
    display: flex;
    flex-direction: column;
  }

  ul li a {
    text-wrap: balance;
  }

  .cover {
    box-sizing: border-box;
    width: 20ch;
    height: 25ch;
    object-fit: contain;

    background-color: var(--pal-light);
    display: block;
    border-radius: 0.25ch;
    border: 0.5ch solid var(--pal-light);
  }
</style>
