---
import { Font } from 'astro:assets';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import Meta, { type Props as MetaProps } from '../components/Meta.astro';

import '@styles/reset.css';
import '@styles/core.css';

interface Props extends MetaProps {}
---

<html lang="en">
  <head>
    <Meta {...Astro.props} />
    <Font cssVariable="--font-equity-caps" preload />
    <Font cssVariable="--font-equity-text" preload />
    <Font cssVariable="--font-fira-code-vf" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: grid;
    min-height: calc(100vh - 1.5rlh);
    grid-template-rows: 1fr min-content;
    justify-items: stretch;
    align-items: stretch;
  }

  main {
    width: 100%;
    box-sizing: border-box;
    justify-self: center;
    max-width: var(--max-content);
    padding-inline: 1.5ch;
  }
</style>
