---
export interface Props {
  date: string | Date;
  class?: string;
  human?: boolean;
  tabular?: boolean;
}

import { format } from 'date-fns';
import { parseDate, toDay } from '../parseDate';

const {
  class: className,
  date: inputDate,
  human = false,
  tabular = false,
} = Astro.props;

const parsed = typeof inputDate === 'string' ? parseDate(inputDate) : inputDate;
const date = toDay(parsed);
const formatStr = human ? 'd MMMM yyyy' : 'yyyy-MM-dd';
const formatted = format(date, formatStr);
---

<time
  class:list={[className, 'common', tabular ? 'tabular' : 'old-style']}
  datetime={date.toISOString()}>{formatted}<slot /></time
><style>
  .old-style {
    font-variant-numeric: normal;
    font-style: italic;
  }

  .tabular {
    font-variant-numeric: oldstyle-nums tabular-nums;
  }
</style>
