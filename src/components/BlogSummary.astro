---
import DayFmt from './dates/DayFmt.astro';

const { blog, showSummary = true } = Astro.props;
const { summary } = blog.data;

const date = blog.data.authorDate ?? new Date();
const isDraft = !blog.data.published;
---

<li class:list={{ draft: isDraft, showSummary, entry: true }}>
  <div class="header">
  { date && (<DayFmt class="byline" date={date} human />) }
  { isDraft && (<div class="draft-marker">Draft</div>)}
  </div>
  <a class="title" href={`/${blog.id}`}>{blog.data.title}</a>
  {showSummary && <p class="summary">{summary}</p>}
</li>

<style>
  li.draft > * {
    opacity: 0.75;
  }

  .title {
    align-self: baseline;
    font-size: var(--f-large);
    font-weight: bold;
  }

  .draft-marker {
    display: inline-block;
    font-family: var(--font-equity-caps);
    letter-spacing: -0.04em;
    font-feature-settings: 'c2sc';
    font-size: var(--f-x-small);
    line-height: 1;
    border: 1px solid currentColor;
    margin-inline-end: 1ch;
    border-radius: 0.25rem;
    padding: 1px 4px;
    color: var(--colors-primary);
    vertical-align: 0.125rem;
  }
</style>
